NODE_ENV=development
IP=localhost
PORT=3002
ROOT_PATH=.

# Postgres (ACL rules, grants, webhook ledger; migrations apply on boot)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=file_server
DB_USER=root
DB_PASSWORD=

# Auth server (JWKS + roles via internal API)
AUTH_SERVER_URL=http://localhost:3001

# Event bus (event-server). disabled = no subscription (dev/tests)
EVENT_SERVER_URL=http://localhost:3005
WEBHOOK_SECRET=

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# File uploads
UPLOADS_PATH=./public/uploads
UPLOADS_URL=/uploads
UPLOADS_ALLOW_TYPES=
# Hard multer ceiling for POST /files/upload, MB (default 50; Nest answers 413)
MAX_UPLOAD_SIZE=50
# Cache-Control max-age for public ACL prefixes, seconds (default 300)
PUBLIC_CACHE_TTL=300
UPLOADS_MAX_SIZE=1048576
UPLOADS_IMAGE_MAX_WIDTH=3840
UPLOADS_IMAGE_MAX_HEIGHT=2160

# Storage backend: local (default) or s3.
# s3 is required for horizontal scaling (shared storage across instances).
FILE_STORAGE=local
S3_BUCKET=
S3_REGION=us-east-1
# Custom endpoint for MinIO / Yandex Object Storage / etc.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO-style path addressing (endpoint/bucket/key)
S3_FORCE_PATH_STYLE=false
# Absolute base for returned URLs (CDN / public bucket); unset = file-server download proxy
S3_PUBLIC_URL=
# External endpoint the CLIENT uses to reach the bucket (edge subdomain in prod,
# published port in dev) — SigV4 covers Host, so presigned URLs must be signed
# for it; file-server's own traffic stays on S3_ENDPOINT. Unset = S3_ENDPOINT.
S3_PRESIGN_ENDPOINT=
# Presigned URL lifetime in seconds (default 900)
S3_PRESIGN_EXPIRES_SEC=900

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=File Server API
SWAGGER_DESCRIPTION=File upload and processing service
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost
LOG_FORMAT=console # LOG_FORMAT=json for structured logs + request id
MORGAN_LOG_FORMAT=dev
